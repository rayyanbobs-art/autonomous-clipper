# Credentials, Secrets & OAuth Tokens
client_secrets.json
youtube_token.json
upload_config.json
*.env
.env
.env.local
*key*.txt
credentials.json
token.pickle
token.json

# Media Outputs & Temporary Render Caches
output/*
!output/.gitkeep
temp/*
!temp/.gitkeep
models/*
!models/.gitkeep

# Video, Audio & Compressed Archives
*.mp4
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.aac
*.rar
*.zip
*.7z
*.tar.gz

