# ==============================================================================
# AutoShorts AI - Environment Configuration Template
# Copy this file to .env and fill in your keys (optional).
# ==============================================================================

# Jev System One Engine (Local decisions or remote endpoint)
# JEV_API_KEY=your_jev_api_key_here
# JEV_ENDPOINT=https://www.jevai.org/api/v1/decisions

# Pexels API Key for dynamic B-Roll video insertion (Optional)
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Google Gemini API Key for Niche Outlier Blueprints (Optional)
# GEMINI_API_KEY=

# Ayrshare API Key for multi-platform posting (TikTok, Instagram, YouTube)
# AYRSHARE_API_KEY=
